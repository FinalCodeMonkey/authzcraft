<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.fcm</groupId>
    <artifactId>authzcraft</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>authzcraft</name>
    <description>AuthzCraft data authorization backend.</description>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
        <maven.clean.plugin.version>3.3.2</maven.clean.plugin.version>
        <flatten.maven.plugin.version>1.3.0</flatten.maven.plugin.version>
        <maven.deploy.plugin.version>3.1.3</maven.deploy.plugin.version>
    </properties>

    <modules>
        <module>parent</module>
        <module>authzcraft-api</module>
        <module>authzcraft-common</module>
        <module>authzcraft-pap</module>
        <module>authzcraft-pdp</module>
        <module>authzcraft-pip</module>
        <module>authzcraft-audit</module>
        <module>authzcraft-pep-spring-boot-starter</module>
        <module>authzcraft-boot</module>
    </modules>

    <distributionManagement>
        <repository>
            <id>releases</id>
            <name>fcm Nexus Releases</name>
            <url>http://nexus.fcm.com.cn:8081/nexus/content/repositories/releases/</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <name>fcm Nexus Snapshots</name>
            <url>http://nexus.fcm.com.cn:8081/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>${maven.clean.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten.maven.plugin.version}</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven.deploy.plugin.version}</version>
                <configuration>
                    <deployAtEnd>true</deployAtEnd>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>